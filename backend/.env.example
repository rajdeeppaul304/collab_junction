# -------------------------------------------------------------------
# Backend Environment Configuration Template
# -------------------------------------------------------------------

# Flask Security & Environment
SECRET_KEY=change-to-a-random-secure-string-in-production
FLASK_ENV=development
PORT=5000

# Database Configuration
# Local SQLite: sqlite:///users.db
# Render / Supabase / Neon PostgreSQL: postgresql://username:password@hostname:5432/dbname
SQLALCHEMY_DATABASE_URI=sqlite:///users.db

# JWT Authentication
JWT_SECRET_KEY=change-to-a-secure-jwt-secret-in-production
JWT_ACCESS_TOKEN_EXPIRES=7

# Email Service (Optional for local dev, mandatory for verification emails in prod)
# For Gmail: Use a 16-character Google App Password (not your normal Gmail login password).
# Generate it at: Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# CORS Configuration (Comma-separated list of allowed origins or * for open)
# Local: http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (For email verification redirect and OAuth callback redirects)
FRONTEND_URL=http://localhost:5173

# GitHub OAuth (Optional, needed only if using GitHub sign-in)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_ACCESS_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_BASE_URL=https://api.github.com/
GITHUB_SCOPE=user:email
